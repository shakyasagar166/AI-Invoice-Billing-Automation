# Application Environment Variables
PROJECT_NAME="AI Invoice & Billing Automation System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="invoice-secret-key-super-secure-2026"
API_KEY="invoice-api-key-2026"

DATABASE_URL="sqlite:///./invoices.db"

# LLM Providers
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
MOCK_LLM=true

# Matching & Thresholds
PRICE_TOLERANCE_PERCENT=2.0
AUTO_APPROVE_LIMIT_USD=1500.0
